{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Family Law Research Graph Record",
  "type": "object",
  "required": ["id", "type", "title", "status", "sources", "relationships"],
  "properties": {
    "id": {"type": "string"},
    "type": {"type": "string", "enum": ["authority", "case", "legislation", "person", "institution", "evidence", "argument", "analysis"]},
    "title": {"type": "string"},
    "jurisdiction": {"type": "string"},
    "date": {"type": "string"},
    "status": {"type": "string", "enum": ["verified", "indexed", "unresolved", "analytical"]},
    "topics": {"type": "array", "items": {"type": "string"}},
    "sources": {"type": "array", "items": {"type": "object", "required": ["title", "kind", "locator"], "properties": {"title": {"type": "string"}, "kind": {"type": "string", "enum": ["primary", "official", "secondary", "empirical", "archival"]}, "locator": {"type": "string"}, "accessed": {"type": "string"}}}},
    "relationships": {"type": "array", "items": {"type": "object", "required": ["relation", "target"], "properties": {"relation": {"type": "string"}, "target": {"type": "string"}, "confidence": {"type": "string", "enum": ["documented", "probable", "analytical", "unresolved"]}}}},
    "notes": {"type": "string"}
  }
}
